---
interface Props {
    src: string;
    alt: string;
    width?: number;
    height?: number;
}

const { src, alt } = Astro.props;
---

<div
    class="group relative w-full max-w-[300px] sm:max-w-[400px] md:max-w-[500px] lg:max-w-[800px] mx-auto perspective"
>
    <a
        href="https://credenciales.uth.hn/e1fc09b1-9b37-4781-942a-cae70b887f04#acc.OFHta8y4"
        target="_blank"
        class="image-wrapper block relative transition-transform duration-200 ease-out transform-gpu"
    >
        <img
            src={src}
            alt={alt}
            class="w-full h-auto aspect-auto rounded-lg object-cover shadow-md border transition-shadow duration-300
             group-hover:shadow-xl"
        />
    </a>
</div>

<script>
    const containers = document.querySelectorAll(".perspective");

    containers.forEach((container) => {
        const wrapper = container.querySelector(
            ".image-wrapper",
        ) as HTMLElement | null;

        container.addEventListener("mousemove", (event) => {
            const e = event as MouseEvent;
            if (window.matchMedia("(hover: hover)").matches) {
                const rect = container.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const xPercent = (x / rect.width - 0.5) * 2;
                const yPercent = (y / rect.height - 0.5) * 2;

                const rotateX = -yPercent * 15;
                const rotateY = xPercent * 15;
                const translateZ = 50;

                if (wrapper) {
                    wrapper.style.transform = `translateZ(${translateZ}px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
                }
            }
        });

        container.addEventListener("mouseleave", () => {
            if (wrapper) {
                wrapper.style.transform = "translateZ(0) rotateX(0) rotateY(0)";
            }
        });
    });
</script>

<style>
    .perspective {
        perspective: 1000px;
    }

    .image-wrapper {
        transform-style: preserve-3d;
        transform: translateZ(0) rotateX(0) rotateY(0);
    }
</style>
